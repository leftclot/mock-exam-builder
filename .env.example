# Copy to .env (gitignored) and fill in. Never put tokens or passwords here or in chat.
# Folder of your mock-exam site (created with scripts/init_site.py)
SITE_DIR=H:\path\to\your\site
# Optional: folders where your notes usually live (semicolon-separated), searched when gathering sources
NOTES_ROOTS=
# Public URL of the site (e.g. https://<machine>.<tailnet>.ts.net) — used when reporting links
PUBLIC_URL=
